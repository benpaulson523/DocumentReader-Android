<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegistrationDataActivity"
    android:tag="content">
    
    <ImageView
        android:id="@+id/bannerImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/otherscreensbackground" />

    <ImageView
        android:id="@+id/resolvedIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/resolvedicon"
        android:layout_marginTop="72dp" 
        android:layout_marginStart="24dp" />

    <TextView
        android:id="@+id/verified"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Verified"
        android:textColor="@color/green"
        style="@style/AppTextXLarge"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/resolvedIcon"
        app:layout_constraintStart_toStartOf="@id/resolvedIcon"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"  />

    <TextView
        android:id="@+id/nameLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Name:"
        android:textColor="@android:color/black"
        style="@style/AppTextXLarge"
        app:layout_constraintTop_toBottomOf="@id/verified"
        app:layout_constraintStart_toStartOf="@id/verified"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"  />

    <TextView
        android:id="@+id/nameValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@android:color/black"
        style="@style/AppTextXLarge"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/nameLabel"
        app:layout_constraintStart_toStartOf="@id/nameLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/dobLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Date of Birth:"
        android:textColor="@android:color/black"
        style="@style/AppTextXLarge"
        app:layout_constraintTop_toBottomOf="@id/nameValue"
        app:layout_constraintStart_toStartOf="@id/nameValue"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/dobValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@android:color/black"
        style="@style/AppTextXLarge"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/dobLabel"
        app:layout_constraintStart_toStartOf="@id/dobLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/addressLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Address:"
        android:textColor="@android:color/black"
        style="@style/AppTextXLarge"
        app:layout_constraintTop_toBottomOf="@id/dobValue"
        app:layout_constraintStart_toStartOf="@id/dobValue"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/addressValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@android:color/black"
        style="@style/AppTextXLarge"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/addressLabel"
        app:layout_constraintStart_toStartOf="@id/addressLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/emailLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email:"
        android:textColor="@android:color/black"
        style="@style/AppTextLarge"
        app:layout_constraintTop_toBottomOf="@id/addressValue"
        app:layout_constraintStart_toStartOf="@id/addressValue"
        android:layout_marginTop="24dp" />

    <EditText
        android:id="@+id/emailValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@android:color/black"
        style="@style/AppTextLarge"
        android:textStyle="bold"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toTopOf="@id/emailLabel"
        app:layout_constraintStart_toEndOf="@id/emailLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/emailLabel"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="4dp" />

    <TextView
        android:id="@+id/phoneLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone:"
        android:textColor="@android:color/black"
        style="@style/AppTextLarge"
        app:layout_constraintTop_toBottomOf="@id/emailLabel"
        app:layout_constraintStart_toStartOf="@id/emailLabel"
        android:layout_marginTop="24dp" />

    <EditText
        android:id="@+id/phoneValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@android:color/black"
        style="@style/AppTextLarge"
        android:textStyle="bold"
        android:inputType="phone"
        app:layout_constraintTop_toTopOf="@id/phoneLabel"
        app:layout_constraintStart_toEndOf="@id/phoneLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/phoneLabel"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="4dp" />

    <TextView
        android:id="@+id/confirmationMethodLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Receive code via:"
        android:textColor="@android:color/black"
        style="@style/AppTextLarge"
        app:layout_constraintTop_toBottomOf="@id/phoneValue"
        app:layout_constraintStart_toStartOf="@id/phoneLabel"
        android:layout_marginTop="24dp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/confirmationMethodGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/confirmationMethodLabel"
        app:layout_constraintBottom_toBottomOf="@id/confirmationMethodLabel"
        app:layout_constraintStart_toEndOf="@id/confirmationMethodLabel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="16dp" >
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email"
            app:backgroundTint="@color/white"
            app:strokeColor="@color/philippines_blue"
            app:strokeWidth="2dp"
            app:cornerRadius="16dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMS"
            app:backgroundTint="@color/white"
            app:strokeColor="@color/philippines_blue"
            app:strokeWidth="2dp"
            app:cornerRadius="16dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <Button
        android:id="@+id/sendBtn"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="SEND CODE"
        android:enabled="false"
        android:backgroundTint="?attr/colorSecondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
