<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:tag="content">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/app_name" />

    <EditText
        android:id="@+id/mnemonicInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:inputType="none"
        android:hint="Mnemonic UUID"
        android:focusable="false"
        android:cursorVisible="false"
        android:longClickable="false"
        android:clickable="false"
        app:layout_constraintTop_toBottomOf="@+id/toolBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/refreshMnemonicButton" />

    <Button
        android:id="@+id/refreshMnemonicButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Regenerate ID"
        app:layout_constraintTop_toBottomOf="@+id/toolBar"
        app:layout_constraintStart_toEndOf="@+id/mnemonicInput"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/scanDocumentBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scan Proof of Identity"
        app:layout_constraintTop_toBottomOf="@+id/refreshMnemonicButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/nameTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:text="Name:"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mnemonicInput" />

    <TextView
        android:id="@+id/surnameTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:text="Surname:"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nameTv" />

    <TextView
        android:id="@+id/dobTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:text="Date of Birth:"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/surnameTv" />

    <TextView
        android:id="@+id/sexTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:text="Sex:"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dobTv" />

    <ImageView
        android:id="@+id/resultIv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/sexTv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Extra fields shown after document capture -->
    <TextView
        android:id="@+id/emailLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email:"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/resultIv"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp" />
    <EditText
        android:id="@+id/emailInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter email"
        android:inputType="textEmailAddress"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/resultIv"
        app:layout_constraintStart_toEndOf="@+id/emailLabel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp" />

    <TextView
        android:id="@+id/phoneLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone Number:"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/emailLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp" />
    <EditText
        android:id="@+id/phoneInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter phone number"
        android:inputType="phone"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/emailLabel"
        app:layout_constraintStart_toEndOf="@+id/phoneLabel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp" />

    <TextView
        android:id="@+id/streetLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Street Address:"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/phoneLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp" />
    <EditText
        android:id="@+id/streetInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter street address"
        android:inputType="textPostalAddress"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/phoneLabel"
        app:layout_constraintStart_toEndOf="@+id/streetLabel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp" />

    <TextView
        android:id="@+id/cityLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="City:"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/streetLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp" />
    <EditText
        android:id="@+id/cityInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter city"
        android:inputType="text"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/streetLabel"
        app:layout_constraintStart_toEndOf="@+id/cityLabel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp" />

    <TextView
        android:id="@+id/provinceLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Province:"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/cityLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp" />
    <EditText
        android:id="@+id/provinceInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter province"
        android:inputType="text"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/cityLabel"
        app:layout_constraintStart_toEndOf="@+id/provinceLabel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp" />

    <TextView
        android:id="@+id/postalLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Postal Code:"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/provinceLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp" />

    <EditText
        android:id="@+id/postalInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter postal code"
        android:inputType="textPostalAddress"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/provinceLabel"
        app:layout_constraintStart_toEndOf="@+id/postalLabel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp" />

    <Button
        android:id="@+id/verifyEmailBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Verify Email"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/postalInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <TextView
        android:id="@+id/emailCodeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="6-digit email code:"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/postalInput"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp" />
    <EditText
        android:id="@+id/emailCodeInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter code"
        android:inputType="number"
        android:maxLength="6"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/postalInput"
        app:layout_constraintStart_toEndOf="@+id/emailCodeLabel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp" />

    <Button
        android:id="@+id/registerBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Register"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/emailCodeInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!--<CheckBox
        android:id="@+id/doRfidCb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Perform NFC chip reading"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        app:layout_constraintBottom_toTopOf="@+id/scanDocumentBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />-->

    <Button
        android:id="@+id/settingsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
