<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegistrationSelectDocActivity"
    android:tag="content">
    
    <ImageView
        android:id="@+id/bannerImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/otherscreensbackground" />

    <!-- Title/lead text -->
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Select the type of document you wish to scan."
        android:textColor="@android:color/black"
        style="@style/AppTextXLarge"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="72dp" 
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <LinearLayout
        android:id="@+id/buttonGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" 
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center" >

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPassport"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Passport"
            style="@style/AppTextMedium"
            android:paddingTop="7dp"
            android:textColor="@android:color/black"
            android:textAllCaps="false"
            app:cornerRadius="4dp"
            app:backgroundTint="@color/white"
            app:strokeColor="@color/philippines_blue"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDriverLicense"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Driver License"
            style="@style/AppTextMedium"
            android:paddingTop="7dp"
            android:textColor="@android:color/black"
            android:textAllCaps="false"
            app:cornerRadius="4dp"
            app:backgroundTint="@color/white"
            app:strokeColor="@color/philippines_blue"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGovernmentID"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Government ID"
            style="@style/AppTextMedium"
            android:paddingTop="7dp"
            android:textColor="@android:color/black"
            android:textAllCaps="false"
            app:cornerRadius="4dp"
            app:backgroundTint="@color/white"
            app:strokeColor="@color/philippines_blue"
            app:strokeWidth="2dp" />
    </LinearLayout>
        
    <Button
        android:id="@+id/continueBtn"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="CONTINUE"
        style="@style/AppTextMedium"
        android:backgroundTint="?attr/colorSecondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingTop="7dp"
        android:layout_marginBottom="14dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
