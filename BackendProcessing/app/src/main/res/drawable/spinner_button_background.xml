<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Button outline -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/>

            <stroke
                android:width="2dp"
                android:color="#000000" />

            <corners android:radius="12dp"/>

            <padding
                android:left="10dp"
                android:top="12dp"
                android:right="10dp"
                android:bottom="10dp" />
        </shape>
    </item>

</layer-list>
